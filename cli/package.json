{
  "name": "@whitegodkingsley/arena-cli",
  "version": "0.4.2",
  "description": "AI-powered video clip generation tool for the terminal - Turn long-form content into viral clips",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arena": "dist/launcher.js"
  },
  "files": [
    "dist/",
    "scripts/postinstall.cjs",
    "scripts/verify-package.cjs",
    "engine/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.cjs",
    "clean": "node scripts/clean.cjs",
    "prebuild": "npm run check:node && npm run clean",
    "build": "tsc",
    "postbuild": "node scripts/postbuild.cjs",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "npm run build && husky",
    "postinstall": "node scripts/postinstall.cjs",
    "smoke:consumer": "node scripts/consumer-install-smoke.cjs",
    "prepack": "node scripts/require-staged-publish.cjs",
    "prepublishOnly": "node scripts/require-staged-publish.cjs",
    "package:stage": "npm run build && node scripts/stage-package.cjs",
    "package:artifact": "npm run package:stage && node scripts/pack-install-artifact.cjs",
    "package:inspect": "npm run package:stage && npm pack .package --dry-run",
    "publish:package": "npm run package:stage && npm publish .package --provenance --access public"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "tests/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "video",
    "editing",
    "ai",
    "cli",
    "clips",
    "content-creation",
    "whisper",
    "openai",
    "ffmpeg",
    "social-media",
    "youtube",
    "tiktok",
    "shorts",
    "highlights"
  ],
  "author": "Arena Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamwhitegod/arena.git"
  },
  "bugs": {
    "url": "https://github.com/iamwhitegod/arena/issues"
  },
  "homepage": "https://getarena.vercel.app",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.12",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.5",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
